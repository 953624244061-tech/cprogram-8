#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, newn, i;
    int *a;

    printf("Enter initial size: ");
    scanf("%d", &n);

    a = (int *)malloc(n * sizeof(int));

    if (a == NULL)
    {
        printf("Memory allocation failed");
        return 1;
    }

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    printf("Enter number of new elements: ");
    scanf("%d", &newn);

    a = (int *)realloc(a, (n + newn) * sizeof(int));

    if (a == NULL)
    {
        printf("Memory reallocation failed");
        return 1;
    }

    printf("Enter %d new elements:\n", newn);

    for (i = n; i < n + newn; i++)
    {
        scanf("%d", &a[i]);
    }

    printf("All elements are:\n");

    for (i = 0; i < n + newn; i++)
    {
        printf("%d ", a[i]);
    }

    free(a);

    return 0;
}
